# Пример конфигурации Nginx Reverse Proxy для FastAPI
# Скопируйте в /etc/nginx/sites-available/vpn-api
# Не забудьте заменить api.maximikvpn.fun на ваш домен

server {
    listen 80;
    server_name api.maximikvpn.fun;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Для больших конфигов (если много VLESS ссылок)
    client_max_body_size 10m;
}